    },
    "Body_assignment_release": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assignment_id",
        "generation",
        "reason"
      ],
      "additionalProperties": false
    },
    "Body_task_reopen": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "Body_task_cancel": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "Command": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": "task-core-draft-1"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation": {
          "enum": [
            "task.create",
            "task.revise",
            "task.claim",
            "run.start",
            "run.report",
            "run.submit",
            "run.fail",
            "task.decide",
            "assignment.release",
            "task.reopen",
            "task.cancel"
          ]
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "protocol_version",
        "command_id",
        "task",
        "expected_revision",
        "operation",
        "body"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "task.create"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/Body_task_create"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "task.revise"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/Body_task_revise"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "task.claim"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/Body_task_claim"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "run.start"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/Body_run_start"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "run.report"
              }
            }
          },
          "then": {
            "properties": {
              "body": {
                "$ref": "#/$defs/Body_run_report"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "run.submit"
              }
            }
          },
