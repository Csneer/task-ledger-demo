{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-task-bridge:task-core-draft-1",
  "title": "Experimental human/Agent task core; no transport or authentication mechanism",
  "$ref": "#/$defs/Command",
  "$defs": {
    "TaskRef": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "authority_id",
        "task_id"
      ],
      "additionalProperties": false
    },
    "ActorRef": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "HostContext": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorRef"
        },
        "can_execute": {
          "type": "boolean"
        },
        "can_read_history": {
          "type": "boolean"
        }
      },
      "required": [
        "actor",
        "can_execute",
        "can_read_history"
      ],
      "additionalProperties": false
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
      },
      "additionalProperties": true
    },
    "ResourceRef": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "parent",
            "related",
            "depends_on",
            "external"
          ]
        },
        "target": {
          "$ref": "#/$defs/TaskRef"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    "Expectation": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "delivery_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "goal",
        "expected_result"
      ],
      "additionalProperties": false
    },
    "ExpectationVersion": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "delivery_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "changed_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "goal",
        "expected_result",
        "version",
        "changed_by",
        "reason"
      ],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "issuer": {
          "$ref": "#/$defs/ActorRef"
        },
        "state": {
          "enum": [
            "offered",
            "claimed",
            "active",
            "submitted",
            "completed",
            "rejected",
            "failed",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectation_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectationVersion"
          },
          "minItems": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "current_assignment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "current_run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_submission_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        }
      },
      "required": [
        "authority_id",
        "task_id",
        "issuer",
        "state",
        "revision",
        "expectation_version",
        "expectations",
        "generation",
        "current_assignment_id",
        "current_run_id",
        "pending_submission_id",
        "relations"
      ],
      "additionalProperties": false
    },
    "Assignment": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignee": {
          "$ref": "#/$defs/ActorRef"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "claimed",
            "active",
            "completed",
            "released",
            "failed",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task",
        "assignment_id",
        "assignee",
        "generation",
        "state"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignee": {
          "$ref": "#/$defs/ActorRef"
        },
        "basis_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "running",
            "submitted",
            "released",
            "failed",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task",
        "run_id",
        "assignment_id",
        "assignee",
        "basis_version",
        "state"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "report_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reported_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "task",
        "report_id",
        "run_id",
        "reported_by",
        "message",
        "extensions"
      ],
      "additionalProperties": false
    },
    "Submission": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "basis_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "submitted_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "task",
        "submission_id",
        "assignment_id",
        "run_id",
        "basis_version",
        "submitted_by",
        "summary",
        "artifacts",
        "extensions"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TaskRef"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decided_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "basis_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evaluated_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "task",
        "decision_id",
        "submission_id",
        "decided_by",
        "outcome",
        "reason",
        "basis_version",
        "evaluated_version"
      ],
      "additionalProperties": false
    },
    "Record": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "record_type": {
              "const": "Assignment"
            },
            "record": {
              "$ref": "#/$defs/Assignment"
            }
          },
          "required": [
            "record_type",
            "record"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "record_type": {
              "const": "Run"
            },
            "record": {
              "$ref": "#/$defs/Run"
            }
          },
          "required": [
            "record_type",
            "record"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "record_type": {
              "const": "Report"
            },
            "record": {
              "$ref": "#/$defs/Report"
            }
          },
          "required": [
            "record_type",
            "record"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "record_type": {
              "const": "Submission"
            },
            "record": {
              "$ref": "#/$defs/Submission"
            }
          },
          "required": [
            "record_type",
            "record"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "record_type": {
              "const": "Decision"
            },
            "record": {
              "$ref": "#/$defs/Decision"
            }
          },
          "required": [
            "record_type",
            "record"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Body_task_create": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "delivery_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        }
      },
      "required": [
        "goal",
        "expected_result"
      ],
      "additionalProperties": false
    },
    "Body_task_revise": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "expected_result": {
          "type": "string",
          "minLength": 1
        },
        "delivery_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "goal",
        "expected_result",
        "reason"
      ],
      "additionalProperties": false
    },
    "Body_task_claim": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "Body_run_start": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "basis_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "assignment_id",
        "generation",
        "basis_version"
      ],
      "additionalProperties": false
    },
    "Body_run_report": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
