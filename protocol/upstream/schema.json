        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "assignment_id",
        "generation",
        "run_id",
        "message"
      ],
      "additionalProperties": false
    },
    "Body_run_submit": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "basis_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRef"
          }
        },
        "extensions": {
          "$ref": "#/$defs/Extensions"
        }
      },
      "required": [
        "assignment_id",
        "generation",
        "run_id",
        "basis_version",
        "summary"
      ],
      "additionalProperties": false
    },
    "Body_run_fail": {
